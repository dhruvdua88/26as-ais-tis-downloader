{
  "name": "26as-ais-tis-downloader",
  "version": "2.0.0",
  "description": "One-click 26AS, AIS and TIS downloader from the Indian Income Tax e-Filing portal. Built for Indian CA firms. Cross-platform (Windows + macOS), bulk Excel import, timestamped per-PAN output.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "playwright install chromium",
    "dist:prep": "node scripts/prebuild.js",
    "dist": "npm run dist:prep && electron-builder --win nsis --x64",
    "dist:win": "npm run dist:prep && electron-builder --win nsis --x64",
    "dist:mac": "npm run dist:prep && electron-builder --mac dmg zip",
    "dist:all": "npm run dist:prep && electron-builder -mw"
  },
  "author": {
    "name": "CA Akshay Daiya",
    "email": "akshaybkn@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akshaybkn/26as-ais-tis-downloader"
  },
  "keywords": [
    "income-tax",
    "26AS",
    "AIS",
    "TIS",
    "TRACES",
    "India",
    "CA",
    "ITR",
    "electron"
  ],
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1"
  },
  "dependencies": {
    "playwright": "^1.47.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.akshaydaiya.26as-ais-tis-downloader",
    "productName": "26AS AIS TIS Downloader",
    "icon": "assets/icon.ico",
    "asar": false,
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-splash.js",
      "renderer/**/*",
      "automation/**/*",
      "vendor/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!data/**/*",
      "!dist-installer/**/*",
      "!.tmp.driveupload/**/*",
      "!**/*.md",
      "!vendor/qpdf/bin/README.txt",
      "!node_modules/playwright-core/.local-browsers/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.finance",
      "artifactName": "26AS-AIS-TIS-Downloader-${version}-${arch}.${ext}",
      "identity": null
    },
    "dmg": {
      "title": "26AS AIS TIS Downloader",
      "artifactName": "26AS-AIS-TIS-Downloader-${version}-${arch}.dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "26AS AIS TIS Downloader",
      "artifactName": "26AS-AIS-TIS-Downloader-Setup-${version}.exe",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
